FROM node:24.13-bookworm-slim AS builder

ARG commitHash
ENV DOCKER_COMMIT_HASH=${commitHash}
ENV CYPRESS_INSTALL_BINARY=0

WORKDIR /build
COPY frontend/package.json frontend/package-lock.json ./
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential git rsync \
    && rm -rf /var/lib/apt/lists/*
COPY frontend/ ./
RUN cp mempool-frontend-config.pumpologia.json mempool-frontend-config.json
# The upstream dependency graph contains optional peer combinations that npm
# resolves differently between minor releases. Pin the lockfile resolution mode
# so recovery builds remain deterministic; dev dependencies are build-only and
# are discarded with this stage.
RUN bash meta/scripts/check-install-scripts.sh && npm ci --legacy-peer-deps --omit=optional
RUN npm run build

FROM nginx:1.30.1-alpine

WORKDIR /patch

COPY --from=builder /build/dist/mempool /var/www/mempool
COPY docker/frontend/entrypoint.sh docker/frontend/wait-for ./
COPY nginx.conf /etc/nginx/nginx.conf
COPY http-basic.conf /etc/nginx/http-basic.conf
COPY nginx-mempool.conf /etc/nginx/conf.d/nginx-mempool.conf

RUN chmod +x /patch/entrypoint.sh /patch/wait-for \
    && chown -R 1000:1000 /patch /var/cache/nginx /var/log/nginx /etc/nginx/nginx.conf /etc/nginx/http-basic.conf /etc/nginx/conf.d /var/www/mempool \
    && touch /var/run/nginx.pid \
    && chown 1000:1000 /var/run/nginx.pid

USER 1000

ENTRYPOINT ["/patch/entrypoint.sh"]
CMD ["nginx", "-g", "daemon off;"]
